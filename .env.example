# ─────────────────────────────────────────────────────────────────────────────
# bridge — the only component that holds third-party credentials
# ─────────────────────────────────────────────────────────────────────────────
PORT=8080
SPECFORGE_CONFIG=/app/config.yaml
DATA_DIR=/data

# Linear OAuth app installed with actor=app (run `pnpm setup:linear`)
LINEAR_ACCESS_TOKEN=
LINEAR_WEBHOOK_SECRET=

# GitHub token with contents:write on the product repo (pushes design/* branches only)
GITHUB_TOKEN=

# Bearer token of the product agent (generate with `openssl rand -hex 32`)
PRODUCT_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# agent — holds only its role token and an Anthropic key
# ─────────────────────────────────────────────────────────────────────────────
BRIDGE_URL=http://bridge:8080
ANTHROPIC_API_KEY=
# Read-only clone of the product's codebase, used to check what already exists
REPO_CLONE_URL=
# Optional: read-only clone of your private setup repo (skills/, templates/, context.md)
SETUP_REPO_URL=
